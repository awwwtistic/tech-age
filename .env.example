# Sanity — public project values (safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=j9d7duit
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-10

# NextAuth (Auth.js) — required; generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical site URL in production (e.g. https://your-site.netlify.app)
AUTH_URL=

# OAuth providers — Google is always shown; GitHub button appears only when both are set
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Stripe secret key (sk_test_... or sk_live_...) — required for checkout
STRIPE_SECRET_KEY=

# Firebase Admin service-account JSON on a single line — required for saving orders
FIREBASE_SERVICE_ACCOUNT_KEY=

# Email granted the Studio link in the header
ADMIN_EMAIL=